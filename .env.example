# ---------------------------------------------------------------------------
# Bootstrap configuration.
#
# These values seed the SQLite settings table on first start. Afterwards every
# setting is managed from the admin dashboard and the database is the source
# of truth, so editing this file has no effect on an existing installation.
# Only HOST, PORT and DB_FILE remain environment-only.
# ---------------------------------------------------------------------------

# Server
# 0.0.0.0 binds every interface; use 127.0.0.1 to restrict to this machine.
HOST=0.0.0.0
PORT=56787
DB_FILE=.openai-proxy-server/proxy.db

# Dashboard
DASHBOARD=true
DASHBOARD_PATH=dashboard
SITE_NAME=OpenAI Proxy
# Strongly recommended: protects the admin dashboard and its API.
# ADMIN_TOKEN=change-me

# Upstream APIs
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=sk-or-v1-
OPENAI_MODEL=google/gemma-4-26b-a4b-it

TTS_BASE_URL=https://openrouter.ai/api/v1
TTS_API_KEY=sk-or-v1-
TTS_MODEL=qwen/qwen-audio-3.0-tts-flash
TTS_VOICE=longanhuan_v3.6

STT_BASE_URL=https://openrouter.ai/api/v1
STT_API_KEY=sk-or-v1-
STT_MODEL=qwen/qwen3-asr-flash-2026-02-10

# Fallback models tried in order on availability/capacity failures
# (400/402/404/408/429/5xx, connection or timeout) before any response is
# forwarded. Only JSON requests already using the configured model are
# retried; client-chosen models are never replaced.
# OPENAI_MODEL_FALLBACKS=qwen/qwen3.8-flash,z-ai/glm-5.3-flash
# TTS_MODEL_FALLBACKS=
# STT_MODEL_FALLBACKS=

# default = inject when absent; force = always override; passthrough = never touch.
MODEL_POLICY=default
VOICE_POLICY=default

# Reseller billing
# billed = upstream_cost * (1 + MARKUP_PCT / 100)
MARKUP_PCT=30
FREE_CREDIT_USD=0.25
FREE_CREDIT_EXPIRY_DAYS=30
# Price table used when the provider does not report a cost. USD per 1M tokens
# and USD per audio second; "default" matches unlisted models.
# PRICES={"google/gemma-4-26b-a4b-it":{"input":0.06,"output":0.12},"default":{"input":0.5,"output":1.5}}

# API keys
# Reject proxied requests that do not present a valid key.
REQUIRE_KEY=true
# Only relevant when REQUIRE_KEY=false: treat unknown tokens as anonymous
# instead of rejecting them, so SDKs configured with a placeholder key work.
ACCEPT_ANY_TOKEN=false
# Self-service allowance: keys per IP per calendar month, plus a cooldown.
# 0 disables the limit. Subscriptions and explicit permissions bypass it.
KEY_IP_LIMIT_PER_MONTH=2
KEY_COOLDOWN_SECONDS=30
KEY_GLOBAL_HOURLY_LIMIT=100
KEY_MAX_PER_ACCOUNT=10
# Default limits for new keys:
# KEY_DEFAULT_LIMITS={"spend":{"max_usd":5,"window_hours":720},"requests":{"max":2000,"window_hours":24},"rpm":60,"max_children":2,"allowed_models":[]}
# Per-IP allowances: {"203.0.113.7":10,"198.51.100.9":-1} (-1 = unlimited)
# KEY_IP_OVERRIDES={}
# Token formats (existing keys keep working when these change):
# KEY_PREFIX=sk-opx-
# DASHBOARD_TOKEN_PREFIX=dash_
# REDEEM_CODE_PREFIX=OPX
# Rotating the pepper invalidates every issued key:
# KEY_PEPPER=

# Deployment
# Behind Cloudflare/nginx, trust X-Forwarded-For / CF-Connecting-IP so per-IP
# limits see real client addresses. Enable only behind a trusted proxy.
# TRUST_PROXY=false
CORS_ORIGIN=
MAX_JSON_BODY_MB=50
MAX_STREAM_BODY_MB=512
UPSTREAM_TIMEOUT_MS=0
LOG_LEVEL=info
MAX_LOG_ENTRIES=5000
LOG_RETENTION_DAYS=30

# Optional OpenRouter attribution headers
# OPENROUTER_HTTP_REFERER=https://example.com
# OPENROUTER_X_TITLE=My Proxy
