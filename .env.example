# Server
# 0.0.0.0 binds every interface so other devices on your network can connect.
# Use 127.0.0.1 to restrict to this machine only.
HOST=0.0.0.0
PORT=56787
DASHBOARD=true
DASHBOARD_PATH=/_proxy
# Optional: protect the local OpenAI-compatible API.
# PROXY_API_KEY=local-secret
# Optional: protect dashboard/API with ?token=... or Authorization: Bearer ...
# DASHBOARD_TOKEN=dashboard-secret

# LLM / generic OpenAI-compatible upstream
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=sk-or-v1-
OPENAI_MODEL=google/gemma-4-26b-a4b-it

# TTS upstream
TTS_BASE_URL=https://openrouter.ai/api/v1
TTS_API_KEY=sk-or-v1-
TTS_MODEL=qwen/qwen-audio-3.0-tts-flash
TTS_VOICE=longanhuan_v3.6

# STT upstream
STT_BASE_URL=https://openrouter.ai/api/v1
STT_API_KEY=sk-or-v1-
STT_MODEL=qwen/qwen3-asr-flash-2026-02-10

# Model behavior: default = inject only when absent; force = override JSON requests;
# passthrough = never inject/override.
MODEL_POLICY=default
VOICE_POLICY=default

# Optional per-request quotas. JSON array of rules; a request must pass every
# matching rule. Fields: metric (tokens | requests), scope (ip | all),
# window (rolling period, e.g. 1h / 24h / 7d / 30d), max (allowance per window).
# Optional exact matchers: model, kind (openai | tts | stt), name (label).
# Example: max 2,000,000 tokens per IP for one model over a rolling 7 days.
# LIMITS=[{"metric":"tokens","scope":"ip","window":"7d","max":2000000,"model":"google/gemma-4-26b-a4b-it"}]
# LIMITS=[{"metric":"requests","scope":"ip","window":"1h","max":100}]
# Generated headers: X-Quota-Used / X-Quota-Max / X-Quota-Remaining /
# X-Quota-Remaining-Pct / X-Quota-Window / X-Quota-Metric. Denied requests
# return HTTP 429 quota_exceeded and never reach the upstream.

# Limits / observability
MAX_JSON_BODY_MB=50
MAX_STREAM_BODY_MB=512
UPSTREAM_TIMEOUT_MS=0
STATS_FILE=.openai-proxy-server/stats.json
MAX_LOG_ENTRIES=1000
LOG_LEVEL=info
CORS_ORIGIN=*

# Optional OpenRouter attribution headers
# OPENROUTER_HTTP_REFERER=https://example.com
# OPENROUTER_X_TITLE=My Proxy
