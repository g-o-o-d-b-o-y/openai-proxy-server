{
  "name": "openai-proxy-server",
  "version": "0.2.0",
  "description": "A tiny OpenAI-compatible reverse proxy for LLM, TTS and STT with streaming, usage stats and a live dashboard.",
  "type": "module",
  "author": "Good Boy",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/g-o-o-d-b-o-y/openai-proxy-server.git"
  },
  "bin": {
    "openai-proxy-server": "./bin/openai-proxy-server.js"
  },
  "exports": {
    ".": "./src/index.js"
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "LICENSE",
    "scr.png",
    ".env.example"
  ],
  "scripts": {
    "start": "node ./bin/openai-proxy-server.js",
    "dev": "node --watch ./bin/openai-proxy-server.js",
    "test": "node --test",
    "check": "node --check ./bin/openai-proxy-server.js && node --check ./src/server.js && node --check ./src/dashboard.js",
    "prepublishOnly": "npm test && npm run check"
  },
  "keywords": [
    "openai",
    "proxy",
    "openai-compatible",
    "openrouter",
    "llm",
    "tts",
    "stt",
    "speech-to-text",
    "text-to-speech",
    "sse"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
